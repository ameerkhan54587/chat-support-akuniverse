# ========================================================
# KAPLIA LIVE CHAT SUPPORT CONSOLE
# PRODUCTION CONFIGURATION (RENDER + TURSO)
# ========================================================

# Server & Admin Login Configuration
PORT=8080
NODE_ENV=production

# Admin Login Credentials (configured here instead of hardcoding)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_custom_password_here

# --------------------------------------------------------
# 1. Turso Cloud Database (Persistent Remote SQLite)
# Get your free database URL and Token at https://turso.tech
# If omitted, server falls back to local chat.db for offline development
# --------------------------------------------------------
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Per-site API credentials are supplied only through the deployment environment.
# Never add API keys to data/sites/*.json or commit them to source control.
SITE_API_KEY_SMSACTIVATE=
SITE_API_KEY_SMSOTPS=
SITE_API_KEY_FBVERSE_BOT=
SITE_API_KEY_TURBOPROXY=
SITE_API_KEY_BUYPVAACCS=

# Per-site Telegram bot credentials are supplied only through the deployment environment.
# Never add bot tokens to data/sites/*.json or commit them to source control.
TELEGRAM_BOT_TOKEN_SMSACTIVATE=
TELEGRAM_BOT_TOKEN_SMSOTPS=
TELEGRAM_BOT_TOKEN_FBVERSE_BOT=
TELEGRAM_BOT_TOKEN_TURBOPROXY=
TELEGRAM_BOT_TOKEN_BUYPVAACCS=
